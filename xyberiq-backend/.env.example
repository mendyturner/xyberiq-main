# Core runtime configuration
XYBERIQ_ENVIRONMENT=development
XYBERIQ_DEBUG=false
XYBERIQ_PROJECT_NAME="XyberIQ Backend"
XYBERIQ_SUPPORT_EMAIL="support@xyberiq.example"

# Database
XYBERIQ_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/xyberiq
XYBERIQ_DATABASE_ECHO=false

# Redis / RQ
XYBERIQ_REDIS_URL=redis://localhost:6379/0
XYBERIQ_RQ_DEFAULT_QUEUE=default

# JWT secrets (rotate in production!)
XYBERIQ_JWT_SECRET_KEY=replace-me
XYBERIQ_JWT_REFRESH_SECRET_KEY=replace-me-too
XYBERIQ_JWT_ALGORITHM=HS256

# S3-compatible storage
XYBERIQ_S3_ENDPOINT_URL=http://localhost:9000
XYBERIQ_S3_REGION=us-east-1
XYBERIQ_S3_BUCKET=xyberiq
XYBERIQ_S3_ACCESS_KEY_ID=localstack
XYBERIQ_S3_SECRET_ACCESS_KEY=localstack
XYBERIQ_S3_USE_SSL=false

# CORS
XYBERIQ_CORS_ALLOW_ORIGINS=http://localhost:3000

# Rate limiting
XYBERIQ_RATE_LIMIT_AUTH_PER_MINUTE=20

# Misc
XYBERIQ_REQUEST_ID_HEADER=X-Request-ID
